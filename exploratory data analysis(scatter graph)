import pandas as pd
import matplotlib.pyplot as plt

# Create dataset
data = {
    "age": [21, 22, 23, 24, 25],
    "salary": [25000, 27000, 29000, 31000, 33000]
}

# Create DataFrame
df = pd.DataFrame(data)

# Describe data
print(df.describe())

# Scatter plot
plt.scatter(df["age"], df["salary"])

# Labels and title
plt.xlabel("Age")
plt.ylabel("Salary")
plt.title("Age vs Salary")

# Show plot
plt.show()
