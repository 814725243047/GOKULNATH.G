import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# -------------------------
# Take user input for data
age_input = input("Enter ages separated by space: ")
salary_input = input("Enter salaries separated by space: ")

# Convert input strings to lists of integers
ages = list(map(int, age_input.split()))
salaries = list(map(int, salary_input.split()))

# Validate input lengths
if len(ages) != len(salaries):
    print("Error: Number of ages and salaries must be the same.")
    exit()

# Create DataFrame
df = pd.DataFrame({
    "age": ages,
    "salary": salaries
})

# Describe data
print("\nData Summary:")
print(df.describe())

# -------------------------
# 1. Line Plot
plt.figure()
plt.plot(df["age"], df["salary"], marker='o', color='blue', linestyle='--')
plt.xlabel("Age")
plt.ylabel("Salary")
plt.title("Line Plot: Age vs Salary")

# -------------------------
# 2. Bar Chart
plt.figure()
plt.bar(df["age"], df["salary"], color='orange')
plt.xlabel("Age")
plt.ylabel("Salary")
plt.title("Bar Chart: Age vs Salary")

# -------------------------
# 3. Histogram
plt.figure()
plt.hist(df["salary"], bins=len(salaries), color='green', edgecolor='black')
plt.xlabel("Salary")
plt.ylabel("Frequency")
plt.title("Histogram of Salary")

# -------------------------
# 4. Pie Chart
plt.figure()
plt.pie(df["salary"], labels=df["age"], autopct='%1.1f%%', startangle=90)
plt.title("Pie Chart: Salary distribution by Age")

# -------------------------
# 5. Box Plot
plt.figure()
plt.boxplot(df["salary"])
plt.ylabel("Salary")
plt.title("Box Plot of Salary")

# -------------------------
# 6. Area Plot
plt.figure()
plt.fill_between(df["age"], df["salary"], color="skyblue", alpha=0.4)
plt.plot(df["age"], df["salary"], color="blue")
plt.xlabel("Age")
plt.ylabel("Salary")
plt.title("Area Plot: Age vs Salary")

# -------------------------
# 7. Heatmap
plt.figure()
sns.heatmap(df.corr(), annot=True, cmap='coolwarm')
plt.title("Heatmap of Correlation")

# -------------------------
# 8. Scatter Plot
plt.figure()
plt.scatter(df["age"], df["salary"], color='red')
plt.xlabel("Age")
plt.ylabel("Salary")
plt.title("Scatter Plot: Age vs Salary")

# Show all plots
plt.show()
